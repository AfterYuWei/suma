FROM golang:1.26-alpine AS build
WORKDIR /src
ARG SUMA_AGENT_VERSION=dev
COPY server/ ./
RUN CGO_ENABLED=0 go build -buildvcs=false -trimpath -ldflags="-s -w -X main.version=${SUMA_AGENT_VERSION}" -o /suma-agent ./cmd/suma-agent

FROM alpine:3.22
RUN apk add --no-cache ca-certificates && mkdir -p /var/lib/suma-agent
COPY --from=build /suma-agent /usr/local/bin/suma-agent
VOLUME ["/var/lib/suma-agent"]
ENTRYPOINT ["suma-agent"]
