# Set a random hexadecimal password (at least 32 characters); never commit .env.
SUMA_POSTGRES_PASSWORD=
SUMA_POSTGRES_PORT=55432
# Native Go development and tests use .env.local (see .env.local.example).
# If using make db-up, use its port 55432 instead of 5432 in .env.local.
# Remote databases should use sslmode=verify-full and a trusted root certificate.
