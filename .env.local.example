# Native Go development and tests automatically read .env.local in the repo root.
# Run make local-config, then replace the database username/password below.
# Existing local PostgreSQL: 127.0.0.1:5432, database suma.
# URL-encode special characters in username/password; single quotes keep $ literal.
SUMA_DATABASE_DSN='postgres://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/suma?sslmode=disable'
# Tests create and remove independent schemas; the role needs CREATE on this database.
SUMA_TEST_DATABASE_DSN=${SUMA_DATABASE_DSN}
